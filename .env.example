# Root env cho Python inference / Agent backend (bước sau)
# Copy: cp .env.example .env

# GPU inference service
HOST=0.0.0.0
PORT=8000
API_KEY=

# Model weights (relative to repo root)
CNN_WEIGHTS=ChordDetection/app/cnn_extractor.h5
CRF_WEIGHTS=ChordDetection/app/model_01

# Temp / upload dirs
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./annotations

# Agent keys — tối thiểu OPENAI_API_KEY + TAVILY_API_KEY (hoặc SERPER)
# Local: uvicorn server.main:app --reload --port 8000
# Railway: xem .env.railway.example + railway.toml
AGENT_MODEL=gpt-4o-mini

# CORS khi frontend ở Vercel (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Agent keys (nếu chạy agent phía Python)
# KHÔNG cần cả 3. Tối thiểu: OPENAI_API_KEY + (TAVILY_API_KEY hoặc SERPER_API_KEY).
OPENAI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# Media tools
FFMPEG_PATH=ffmpeg
SPOTDL_ENABLED=false
