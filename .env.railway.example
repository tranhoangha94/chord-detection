# Railway / production env for Agent API
# Set these in Railway → Variables (do NOT commit real keys)

HOST=0.0.0.0
# Railway injects PORT automatically — don't hardcode in production

# CORS: comma-separated Vercel URLs (no trailing slash)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./annotations

AGENT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
TAVILY_API_KEY=

# Optional
API_KEY=
SERPER_API_KEY=
